# ==============================================================================
# Global Settings
# ==============================================================================
font=monospace 14

# Behavior & Queue
sort=-time
layer=overlay
default-timeout=8000
ignore-timeout=1

# Geometry & Layout
width=300
height=110
padding=15
margin=15,15

# Borders & Style
border-size=2
border-radius=20

# Icons
icons=0
max-icon-size=64

# Generated colors from matugen
include=~/.config/mako/mako-colors
